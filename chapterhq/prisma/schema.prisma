generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  PENDING
  LEFT
  BLOCKED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  ORGANIZATION
  COMMITTEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum AppointmentStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  REVOKED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  WAITLISTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  MAINTENANCE
  DISPOSED
}

//////////////////////////////////////////////////////
// ORGANIZATION
//////////////////////////////////////////////////////

model Organization {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String
  slug String @unique

  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  settings OrganizationSettings?
  members Member[]
  roles Role[]
  invitations Invitation[]
  auditLogs AuditLog[]
  committees Committee[]
  events Event[]
  certificates Certificate[]
  notifications Notification[]
  documents Document[]
  finances FinanceRecord[]
  inventoryItems InventoryItem[]

  @@map("organizations")
}

//////////////////////////////////////////////////////
// COMMITTEE
//////////////////////////////////////////////////////

model Committee {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  committeeMembers CommitteeMember[]
  appointments     Appointment[]

  @@unique([organizationId, name])

  @@map("committees")
}

//////////////////////////////////////////////////////
// COMMITTEE MEMBER
//////////////////////////////////////////////////////

model CommitteeMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  committeeId String @db.ObjectId
  memberId    String @db.ObjectId

  committee Committee @relation(fields: [committeeId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id])

  assignedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([committeeId, memberId])

  @@map("committee_members")
}

//////////////////////////////////////////////////////
// ORGANIZATION SETTINGS
//////////////////////////////////////////////////////

model OrganizationSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @unique @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String?
  email String @unique
  image String?
  password String?
  authProvider String @default("credentials")
  status UserStatus @default(ACTIVE)
  lastLogin DateTime?
  passwordResetToken String?
  passwordResetTokenExpiry DateTime?

  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  members Member[]

  @@map("users")
}

//////////////////////////////////////////////////////
// MEMBER
//////////////////////////////////////////////////////

model Member {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  userId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])
  user User @relation(fields: [userId], references: [id])

  status MemberStatus @default(ACTIVE)

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  userRoles        UserRole[]
  committeeMembers CommitteeMember[]
  appointments     Appointment[]
  registrations    EventRegistration[]
  attendances      Attendance[]
  certificates     Certificate[]

  @@unique([organizationId, userId])

  @@map("members")
}

//////////////////////////////////////////////////////
// APPOINTMENT
//////////////////////////////////////////////////////

model Appointment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  committeeId    String @db.ObjectId
  memberId       String @db.ObjectId

  committee Committee @relation(fields: [committeeId], references: [id])
  member    Member    @relation(fields: [memberId], references: [id])

  designation String
  startDate   DateTime
  endDate     DateTime?

  status AppointmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@map("appointments")
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  name String
  description String?

  scope RoleScope
  status RoleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  userRoles UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])

  @@map("roles")
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  resource String
  action String

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])

  @@map("permissions")
}

//////////////////////////////////////////////////////
// USER ROLE
//////////////////////////////////////////////////////

model UserRole {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  memberId String @db.ObjectId
  roleId String @db.ObjectId

  member Member @relation(fields: [memberId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, roleId])

  @@map("user_roles")
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  roleId String @db.ObjectId
  permissionId String @db.ObjectId

  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])

  @@map("role_permissions")
}

//////////////////////////////////////////////////////
// INVITATION
//////////////////////////////////////////////////////

model Invitation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  roleId         String? @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  email  String
  token  String @unique
  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, email, status])

  @@map("invitations")
}

//////////////////////////////////////////////////////
// EVENT
//////////////////////////////////////////////////////

model Event {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  title                String
  description          String?
  venue                String?
  startDate            DateTime
  endDate              DateTime?
  capacity             Int?
  registrationRequired Boolean  @default(false)

  status EventStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  registrations EventRegistration[]
  attendances   Attendance[]

  @@map("events")
}

//////////////////////////////////////////////////////
// EVENT REGISTRATION
//////////////////////////////////////////////////////

model EventRegistration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  eventId  String @db.ObjectId
  memberId String @db.ObjectId

  event  Event  @relation(fields: [eventId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  status RegistrationStatus @default(REGISTERED)

  registeredAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([eventId, memberId])

  @@map("event_registrations")
}

//////////////////////////////////////////////////////
// ATTENDANCE
//////////////////////////////////////////////////////

model Attendance {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  eventId  String @db.ObjectId
  memberId String @db.ObjectId

  event  Event  @relation(fields: [eventId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  status AttendanceStatus @default(ABSENT)
  notes  String?

  markedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, memberId])

  @@map("attendances")
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorId String @db.ObjectId // Can represent User ID or Member ID of who did it
  actorName String?
  actorEmail String?

  action    String // e.g. create, update, delete, assign, remove
  resource  String // e.g. organization, member, role, user_role, role_permission
  targetId  String? // ID of the affected resource
  targetName String? // Display name of target if available

  metadata Json?

  timestamp DateTime @default(now())

  @@map("audit_logs")
}

//////////////////////////////////////////////////////
// CERTIFICATE
//////////////////////////////////////////////////////

model Certificate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  memberId       String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  title        String
  description  String?
  issueDate    DateTime
  expiryDate   DateTime?
  credentialId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, credentialId])
  @@map("certificates")
}

//////////////////////////////////////////////////////
// NOTIFICATION
//////////////////////////////////////////////////////

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  title       String
  message     String
  type        String
  targetScope String
  isRead      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

//////////////////////////////////////////////////////
// DOCUMENT
//////////////////////////////////////////////////////

model Document {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  title       String
  description String?
  fileUrl     String
  category    String?
  uploadedBy  String?   @db.ObjectId

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("documents")
}

//////////////////////////////////////////////////////
// FINANCE
//////////////////////////////////////////////////////

model FinanceRecord {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  type        TransactionType
  category    String
  amount      Float
  date        DateTime
  description String?
  createdBy   String?         @db.ObjectId

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("finance_records")
}

//////////////////////////////////////////////////////
// INVENTORY
//////////////////////////////////////////////////////

model InventoryItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  name        String
  category    String?
  quantity    Int             @default(0)
  unit        String?
  location    String?
  status      InventoryStatus @default(IN_STOCK)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("inventory_items")
}