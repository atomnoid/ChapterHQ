generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  PENDING
  LEFT
  BLOCKED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  ORGANIZATION
  COMMITTEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

//////////////////////////////////////////////////////
// ORGANIZATION
//////////////////////////////////////////////////////

model Organization {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String
  slug String @unique

  status OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  settings OrganizationSettings?
  members Member[]
  roles Role[]
  invitations Invitation[]
  auditLogs AuditLog[]

  @@map("organizations")
}

//////////////////////////////////////////////////////
// ORGANIZATION SETTINGS
//////////////////////////////////////////////////////

model OrganizationSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @unique @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String?
  email String @unique
  image String?
  password String?
  authProvider String @default("credentials")
  status UserStatus @default(ACTIVE)
  lastLogin DateTime?
  passwordResetToken String?
  passwordResetTokenExpiry DateTime?

  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  members Member[]

  @@map("users")
}

//////////////////////////////////////////////////////
// MEMBER
//////////////////////////////////////////////////////

model Member {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  userId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])
  user User @relation(fields: [userId], references: [id])

  status MemberStatus @default(ACTIVE)

  joinedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  userRoles UserRole[]

  @@unique([organizationId, userId])

  @@map("members")
}

//////////////////////////////////////////////////////
// ROLE
//////////////////////////////////////////////////////

model Role {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  name String
  description String?

  scope RoleScope
  status RoleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  userRoles UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])

  @@map("roles")
}

//////////////////////////////////////////////////////
// PERMISSION
//////////////////////////////////////////////////////

model Permission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  resource String
  action String

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action])

  @@map("permissions")
}

//////////////////////////////////////////////////////
// USER ROLE
//////////////////////////////////////////////////////

model UserRole {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  memberId String @db.ObjectId
  roleId String @db.ObjectId

  member Member @relation(fields: [memberId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, roleId])

  @@map("user_roles")
}

//////////////////////////////////////////////////////
// ROLE PERMISSION
//////////////////////////////////////////////////////

model RolePermission {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  roleId String @db.ObjectId
  permissionId String @db.ObjectId

  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])

  @@map("role_permissions")
}

//////////////////////////////////////////////////////
// INVITATION
//////////////////////////////////////////////////////

model Invitation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  roleId         String? @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  email  String
  token  String @unique
  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, email, status])

  @@map("invitations")
}

//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorId String @db.ObjectId // Can represent User ID or Member ID of who did it
  actorName String?
  actorEmail String?

  action    String // e.g. create, update, delete, assign, remove
  resource  String // e.g. organization, member, role, user_role, role_permission
  targetId  String? // ID of the affected resource
  targetName String? // Display name of target if available

  metadata Json?

  timestamp DateTime @default(now())

  @@map("audit_logs")
}