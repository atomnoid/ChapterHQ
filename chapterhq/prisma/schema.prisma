generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

enum OrganizationStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum NotificationType {
  SYSTEM
  SECURITY
  TRANSACTIONAL
  REMINDER
  ANNOUNCEMENT
}

enum RoleScope {
  GLOBAL
  ORGANIZATION
  DEPARTMENT
  UNIT
}

enum DocumentVisibility {
  PRIVATE
  INTERNAL
  ORGANIZATION
  PUBLIC
}

model Organization {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Basic Information
  name String
  slug String @unique

  /// System Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  /// Relations
  settings OrganizationSettings?
  members  Member[]

  @@map("organizations")
}

model OrganizationSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  organizationId String @unique @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])

  /// System Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Authentication
  name  String?
  email String  @unique
  image String?

  /// Email Verification
  emailVerified DateTime?

  /// System Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  /// Relations
  members Member[]

  @@map("users")
}

model Member {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// Relations
  organizationId String @db.ObjectId
  userId         String @db.ObjectId

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  /// Membership
  joinedAt DateTime @default(now())
  isActive Boolean @default(true)

  /// System Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  /// Future Relations
  // userRoles UserRole[]

  @@unique([organizationId, userId])

  @@map("members")
}